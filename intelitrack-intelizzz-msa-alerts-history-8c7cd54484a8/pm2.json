    },
    {
      "name": "intelizzz-api-alerter",
      "script": "src/workers/alerter-consumer.js",
      "env": {
        "NODE_ENV": "production"
      },
      "env_production": {
        "NODE_ENV": "production"
      },
      "error_file": "./logs/kafka-alerter-worker-out.log",
      "out_file": "./logs/kafka-alerter-worker-out.log",
