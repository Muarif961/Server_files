      "env": {
        "NODE_ENV": "production"
      },
      "env_production": {
        "NODE_ENV": "production"
      },
      "error_file": "./logs/out.log",
      "out_file": "./logs/out.log",
      "merge_logs": true
    },
    {
      "name": "intelizzz-api-alert-history-worker",
      "script": "src/workers/alert-consumer.js",
      "env": {
        "NODE_ENV": "production"
      },
      "env_production": {
        "NODE_ENV": "production"
      },
      "error_file": "./logs/kafka-alert-worker-out.log",
      "out_file": "./logs/kafka-alert-worker-out.log",
